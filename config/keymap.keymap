#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3  &kp N4            &kp N5                                    &kp N6       &kp N7            &kp N8     &kp N9    &kp N0    &kp MINUS
&kp GRAVE  &kp Q     &kp W     &kp E   &kp R             &kp T                                     &kp Y        &kp U             &kp I      &kp O     &kp P     &kp LBKT
&kp TAB    &kp A     &kp S     &kp D   &kp F             &kp G        &mkp LCLK         &mkp RCLK  &kp H        &kp J             &kp K      &kp L     &kp SEMI  &kp RBKT
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V             &kp B        &kp SPACE         &kp RET    &kp N        &kp M             &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &trans  &lt 1 LANGUAGE_2  &lt 2 SPACE  &lt 3 LANGUAGE_1  &kp BSPC   &lt 2 ENTER  &lt 1 LANGUAGE_2  &kp RGUI   &kp INT4  &kp RALT  &kp K_APP
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3   &kp F4  &kp F5                             &kp F6  &kp F7    &kp F8          &kp F9     &kp F10  &kp F11
&trans  &trans  &kp N7  &kp N8   &kp N9  &trans                             &trans  &trans    &trans          &trans     &trans   &kp F12
&trans  &trans  &kp N4  &kp N5   &kp N6  &kp KP_PLUS  &kp PG_UP  &mkp LCLK  &trans  &trans    &kp UP_ARROW    &trans     &trans   &trans
&trans  &trans  &kp N1  &kp N2   &kp N3  &kp MINUS    &kp PG_DN  &trans     &trans  &kp LEFT  &trans          &kp RIGHT  &trans   &trans
&trans  &trans  &kp N0  &kp DOT  &trans  &trans       &trans     &kp DEL    &trans  &trans    &kp DOWN_ARROW  &trans     &trans   &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans                     &trans    &trans     &trans        &trans     &kp EQUAL  &kp INT3
&out OUT_BLE  &trans        &trans        &trans        &trans  &trans                     &kp HOME  &kp PG_UP  &kp PG_DN     &kp END    &trans     &kp RBKT
&out OUT_USB  &trans        &trans        &trans        &trans  &trans   &trans  &trans    &kp LEFT  &kp DOWN   &kp UP_ARROW  &kp RIGHT  &kp COLON  &kp BSLH
&trans        &trans        &trans        &kp INT5      &trans  &trans   &trans  &trans    &kp INT4  &trans     &trans        &trans     &kp INT1   &trans
&bootloader   &trans        &trans        &trans        &trans  &kp TAB  &trans  &kp BSPC  &trans    &trans     &trans        &trans     &trans     &bootloader
            >;
        };
    };
};
